# Copy to .env and adjust. Everything here is optional.

# Database (default: XAMPP MySQL, database "hpc_automation")
# HPC_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/hpc_automation?charset=utf8mb4
# HPC_DATABASE_URL=sqlite:///data/hpc.db

# Secret for signing app logins (default: generated once into data/.jwt_secret)
# HPC_JWT_SECRET=

# Keep these OUTSIDE OneDrive / Google Drive: students' data, PARAKH tokens and keys live here.
# HPC_DATA_DIR=C:/TeacherAssist/data
# HPC_BACKUP_DIR=C:/TeacherAssist/backups
# HPC_BACKUP_KEY_FILE=C:/TeacherAssist/keys/backup.key

# Requests to PARAKH per second per session (default 4; 1.5 during the first live tests).
# HPC_PORTAL_MAX_PER_SECOND=1.5

# UNSUPPORTED: the app reads PARAKH's captcha itself. Off by default; to be removed before any paid launch.
# HPC_AUTO_CAPTCHA=false
