# Where the web app sends API calls. The default /api/v1 goes through the dev server's proxy
# (same origin, so the httpOnly login cookie works). Set a full URL only for a server on another host.
VITE_API_BASE=/api/v1

# Backend the dev server's /api proxy forwards to.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
